{
  "name": "@paletki/backend",
  "private": true,
  "version": "1.0.0",
  "description": "Encore Typescript Starter",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "encore run",
    "build:docker": "encore build docker --config infra.config.json paletki-dev:latest",
    "gen:client": "encore gen client --output=../frontend/src/lib/client.ts --env=local && node ../frontend/scripts/prune-generated-client.mjs",
    "test": "node ./scripts/run-tests.mjs",
    "test:integration": "node ./scripts/run-integration-tests.mjs",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test:postgres": "node ./scripts/run-postgres-tests.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "encore.dev": "^1.58.6",
    "ldapts": "^9.2.0",
    "mysql2": "^3.24.4"
  }
}
