{
  "$schema": "https://encore.dev/schemas/infra.schema.json",
  "metadata": {
    "app_id": "paletki",
    "env_type": "production"
  },
  "secrets": {
    "LDAPLookupBindPassword": {
      "$env": "LDAP_LOOKUP_BIND_PASSWORD"
    }
  },
  "sql_servers": [
    {
      "host": "postgres-db:5432",
      "tls_config": {
        "disabled": true
      },
      "databases": {
        "pallets": {
          "username": "encoredb_user",
          "password": {
            "$env": "PALLETS_DB_PASSWORD"
          }
        }
      }
    }
  ]
}
