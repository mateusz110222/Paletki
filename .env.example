# Copy this file to .env and replace every required value.

# Frontend
VITE_DEV_API_BASE_URL=http://localhost:4000
# Leave empty when nginx proxies /auth and /pallet to the backend.
VITE_PROD_API_BASE_URL=

# Active Directory / LDAP
LDAP_URL=ldaps://ldap.example.com:636
LDAP_LOGIN_DOMAIN=example.com
LDAP_SEARCH_BASE=DC=example,DC=com
LDAP_IT_DEPARTMENTS='BLN - PDS IT Service Delivery;BLN - PDS - IT'
# Exact LDAP department values, separated with semicolons. Empty disables UR-only access.
LDAP_UR_DEPARTMENTS=
# Exact LDAP department values for all views except the IT-only LDAP directory.
LDAP_ME_DEPARTMENTS=
# Optional read-only directory account (UPN or full DN); needed for the IT lookup view.
LDAP_LOOKUP_BIND_USER=
# Self-hosted Encore maps this environment variable to the LDAPLookupBindPassword secret.
# For `encore run`, use: encore secret set --type local LDAPLookupBindPassword
LDAP_LOOKUP_BIND_PASSWORD=
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Keep false unless the LDAP server still uses an RSA-1024 certificate.
LDAP_TLS_ALLOW_LEGACY_SERVER_CERT=false
# The factory LDAP certificate is issued for inconsistent aliases. The CA chain
# remains verified; only SAN/CN hostname matching is skipped.
LDAP_TLS_SKIP_HOSTNAME_VERIFICATION=true
# Optional path to a PEM file containing the corporate CA certificate.
LDAP_CA_CERT_PATH=

# Authentication sessions
AUTH_SESSION_TTL_MINUTES=720

# FIS routers
FIS1_ROUTER_URL=http://fis-router-1.example.local/router.php
FIS2_ROUTER_URL=http://fis-router-2.example.local/router.php
FIS1_UNIT_HISTORY_URL=http://fis-1.example.local/std_public/unithistory
FIS2_UNIT_HISTORY_URL=http://fis-2.example.local/std_public/unithistory
FIS_REQUEST_TIMEOUT_MS=10000
# Completed outbox jobs older than this many days are removed in batches by the worker.
FIS_OUTBOX_COMPLETED_RETENTION_DAYS=30

# Docker / PostgreSQL
POSTGRES_PASSWORD=change-me
BACKEND_IMAGE=paletki-dev:latest
ENCORE_ENV=production

# Dedicated HTTP ingress for production machines. It proxies only /fis/*;
# all other routes on this port return 404.
FIS_INGRESS_PORT=4000

# HTTP port used to open the web application.
FRONTEND_HTTP_PORT=8082
