# Copy this file to .env and replace every required value.

# Frontend
VITE_DEV_API_BASE_URL=http://localhost:4000
# Leave empty when nginx proxies /auth and /pallet to the backend.
VITE_PROD_API_BASE_URL=

# Active Directory / LDAP
LDAP_URL=ldaps://ldap.example.com:636
LDAP_LOGIN_DOMAIN=example.com
LDAP_SEARCH_BASE=DC=example,DC=com
LDAP_IT_DEPARTMENTS='BLN - PDS IT Service Delivery;BLN - PDS - IT'
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Keep false unless the LDAP server still uses an RSA-1024 certificate.
LDAP_TLS_ALLOW_LEGACY_SERVER_CERT=false
# Optional path to a PEM file containing the corporate CA certificate.
LDAP_CA_CERT_PATH=

# Authentication sessions
AUTH_SESSION_TTL_MINUTES=720

# FIS routers
FIS1_ROUTER_URL=http://fis-router-1.example.local/router.php
FIS2_ROUTER_URL=http://fis-router-2.example.local/router.php
FIS1_UNIT_HISTORY_URL=http://fis-1.example.local/std_public/unithistory
FIS2_UNIT_HISTORY_URL=http://fis-2.example.local/std_public/unithistory
FIS_REQUEST_TIMEOUT_MS=10000

# Docker / PostgreSQL
POSTGRES_USER=encoredb_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pallets
POSTGRES_PORT=5432
BACKEND_PORT=4000
FRONTEND_PORT=80
BACKEND_IMAGE=paletki-dev:latest
ENCORE_ENV=production
