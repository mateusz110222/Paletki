{
  "name": "@paletki/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-tool.mjs vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/run-tool.mjs tsx scripts/build-documentation.mjs && node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && node scripts/run-tool.mjs vite build && node scripts/verify-route-chunks.mjs",
    "docs:build": "node scripts/run-tool.mjs tsx scripts/build-documentation.mjs",
    "docs:check": "node scripts/run-tool.mjs tsx scripts/build-documentation.mjs --check",
    "test": "node scripts/run-tool.mjs tsx --test tests/*.test.*",
    "preview": "node scripts/run-tool.mjs vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "node scripts/run-tool.mjs eslint .",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.0",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "8.4.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/eslint-parser": "^7.29.0",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.1"
  }
}
