{
  "name": "@paletki/frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json --noEmit && vite build",
