# Copy to /opt/paletki/.env.production on the Docker host. Never commit secrets.

# Frontend browser settings are baked into the image by GitHub Actions.

# Must match the existing Portainer stack/project name.
COMPOSE_PROJECT_NAME=palletx

# Active Directory / LDAP
LDAP_URL=ldaps://ldap.example.com:636
LDAP_LOGIN_DOMAIN=example.com
LDAP_SEARCH_BASE=DC=example,DC=com
LDAP_TIMEOUT_MS=5000
LDAP_CONNECT_TIMEOUT_MS=3000
LDAP_TLS_REJECT_UNAUTHORIZED=true
# Keep false unless the LDAP server still uses an RSA-1024 certificate.
LDAP_TLS_ALLOW_LEGACY_SERVER_CERT=false
# The factory LDAP certificate is issued for inconsistent aliases. The CA chain
# remains verified; only SAN/CN hostname matching is skipped.
LDAP_TLS_SKIP_HOSTNAME_VERIFICATION=true
# Optional path to a PEM file containing the corporate CA certificate.
LDAP_CA_CERT_PATH=

# Authentication sessions
AUTH_SESSION_TTL_MINUTES=720

# FIS groups (queried via FIS1_ROUTER_URL?job=GetUserGroup)
# IT: fisadmin_group or admin_group. These groups have full access.
# UR and ME groups may be overridden if FIS uses different table names.
FIS_UR_GROUP=Maintenance
FIS_ME_GROUP=proceng
FIS_STRAIN_BLOCKING=false

# FIS routers
FIS1_ROUTER_URL=http://fis-router-1.example.local/router.php
FIS2_ROUTER_URL=http://fis-router-2.example.local/router.php
FIS_REQUEST_TIMEOUT_MS=10000
# Completed outbox jobs older than this many days are removed in batches by the worker.
FIS_OUTBOX_COMPLETED_RETENTION_DAYS=30

# Docker / PostgreSQL
POSTGRES_PASSWORD=change-me
BACKEND_IMAGE=
FRONTEND_IMAGE=
MIGRATIONS_IMAGE=
# Inspect the current database container mounts before changing this value.
POSTGRES_VOLUME=palletx_pgdata
LDAP_CA_CERT_HOST_PATH=/opt/paletki/backend/certs/borgwarner-enterprise-root.pem
ENCORE_ENV=production

# Dedicated HTTP ingress for production machines. It proxies only /fis/*;
# all other routes on this port return 404.
FIS_INGRESS_PORT=4000

# HTTP port used to open the web application.
FRONTEND_HTTP_PORT=8082

# Optional APACS card login. Read-only access to dbo.TCARDISSUE and dbo.TCARDHOLDERS.
APACS_DB_SERVER=
APACS_DB_PORT=1433
APACS_DB_NAME=APACS
APACS_DB_USER=
APACS_DB_PASSWORD=
APACS_DB_ENCRYPT=true
APACS_DB_TRUST_CERTIFICATE=false
APACS_DB_CONNECTION_TIMEOUT_MS=5000
APACS_DB_REQUEST_TIMEOUT_MS=5000
